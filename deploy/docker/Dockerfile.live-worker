ARG PYTHON_IMAGE=python:3.11-slim
FROM ${PYTHON_IMAGE}

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --gid 10001 aevrel \
    && useradd --uid 10001 --gid 10001 --create-home aevrel

WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY spec ./spec
RUN pip install --no-cache-dir .

USER 10001:10001
EXPOSE 9460
ENTRYPOINT ["aevrel-live-worker"]
CMD ["--listen", "0.0.0.0:9460", "--state-dir", "/var/lib/aevrel/live-worker"]
