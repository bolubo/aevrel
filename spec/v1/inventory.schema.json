{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevrel.dev/schemas/inventory-v1.json",
  "title": "AevrelInventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "rank", "format", "metadata_hash", "tensors", "chunks",
    "agent_version", "torch_version"
  ],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "rank": { "type": "integer", "minimum": 0 },
    "format": { "type": "string", "enum": ["dcp"] },
    "metadata_hash": { "$ref": "#/$defs/hash" },
    "tensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "shape", "dtype"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "shape": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "dtype": {
            "type": "string",
            "enum": ["float32", "float16", "bfloat16", "int64", "int32", "uint8"]
          }
        }
      }
    },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tensor", "rank", "file", "tensor_offset", "tensor_size",
          "byte_ranges", "checksum"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/hash" },
          "tensor": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "minLength": 1 },
          "tensor_offset": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "tensor_size": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "byte_ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer", "minimum": 0 }
            }
          },
          "checksum": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "agent_version": { "type": "string", "minLength": 1 },
    "torch_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
