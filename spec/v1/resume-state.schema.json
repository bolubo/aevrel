{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevrel.dev/schemas/resume-state-v1.json",
  "title": "AevrelResumeStateManifest",
  "description": "Checkpoint-level resume-state closure contract. Declares which resume components exist, who provides them, their digests and rank coverage. Structural only: this manifest never asserts loadability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "checkpoint",
    "topology",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1"]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "version", "metadataDigest"],
      "properties": {
        "uid": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "metadataDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worldSize", "mesh"],
      "properties": {
        "worldSize": { "type": "integer", "minimum": 1 },
        "mesh": { "type": "string", "minLength": 1 },
        "placements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind", "name", "provider", "digest",
          "coverage", "required", "present"
        ],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "digest": {
            "type": ["string", "null"],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["worldSize", "ranks"],
            "properties": {
              "worldSize": { "type": "integer", "minimum": 1 },
              "ranks": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "uniqueItems": true
              }
            }
          },
          "required": { "type": "boolean" },
          "present": { "type": "boolean" }
        }
      }
    }
  }
}
