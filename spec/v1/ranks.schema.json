{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevrel.dev/schemas/ranks-v1.json",
  "title": "AevrelLocalRanks",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ranks"],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "ranks": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    }
  }
}
