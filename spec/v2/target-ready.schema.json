{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aevrel.dev/schemas/v2/target-ready.json",
  "title": "TargetReadyV2",
  "oneOf": [
    { "$ref": "#/$defs/rankReport" },
    { "$ref": "#/$defs/aggregate" }
  ],
  "$defs": {
    "resumeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "closure", "components"],
      "description": "Binding of a target readiness claim to the checkpoint-level resume-state manifest. Carries the manifest digest once; component digests stay in the manifest.",
      "properties": {
        "manifestDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "closure": {
          "type": "string",
          "enum": ["COMPLETE", "PARTIAL", "MISSING", "MALFORMED"]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "required", "present"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "present": { "type": "boolean" }
            }
          }
        }
      }
    },
    "rankReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "migrationUID",
        "version",
        "rank",
        "role",
        "modelLoaded",
        "optimizerLoaded",
        "stepsRan",
        "stateComplete",
        "ok",
        "error",
        "resumeState"
      ],
      "properties": {
        "schemaVersion": { "const": "2" },
        "migrationUID": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "rank": { "type": "integer", "minimum": 0 },
        "role": { "type": "string", "minLength": 1 },
        "modelLoaded": { "type": "boolean" },
        "optimizerLoaded": { "type": "boolean" },
        "stepsRan": { "type": "integer", "minimum": 0 },
        "stateComplete": { "type": "boolean" },
        "ok": { "type": "boolean" },
        "error": { "type": "string" },
        "resumeState": { "$ref": "#/$defs/resumeState" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "migrationUID",
        "version",
        "ready",
        "condition",
        "message",
        "ranksReady",
        "ranksTotal",
        "stepsRan",
        "stateComplete",
        "completedAt",
        "reports"
      ],
      "properties": {
        "schemaVersion": { "const": "2" },
        "migrationUID": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "ready": { "type": "boolean" },
        "condition": {
          "type": "string",
          "enum": [
            "Ready",
            "LoadFailed",
            "StepFailed",
            "VersionMismatch",
            "StateClosureIncomplete",
            "Timeout",
            "JobFailed",
            "Incomplete",
            "InvalidJob",
            "InvalidReport",
            "Unsupported",
            "ProofPublishFailed"
          ]
        },
        "message": { "type": "string" },
        "reasonCodes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ranksReady": { "type": "integer", "minimum": 0 },
        "ranksTotal": { "type": "integer", "minimum": 0 },
        "stepsRan": { "type": "integer", "minimum": 0 },
        "stateComplete": { "type": "boolean" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "jobName": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string", "minLength": 1 },
        "missingRanks": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "reports": {
          "type": "array",
          "items": { "$ref": "#/$defs/rankReport" }
        }
      }
    }
  }
}
